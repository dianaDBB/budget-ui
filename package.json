    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-eslint": "^14.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "prettier": "^2.7.1",
    "sass": "^1.69.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vue-tsc": "^3.3.3"
